{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"moduleResolution": "node",
		"allowJs": true,
		"checkJs": true,
		"noImplicitAny": false,
		"strict": false,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": [
		"index.js",
		"src/**/*.js",
		"types.d.ts"
	],
	"exclude": [
		"dist",
		"node_modules",
		"bots/**",
		"src/bots/**",
		"src/modules/**"
	]
}